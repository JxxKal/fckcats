# ── Pflicht ───────────────────────────────────────────────────────────────────
# Signiert die JWTs. MUSS vor dem ersten Start geaendert werden.
#   openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# Passwort des lokalen Bootstrap-Admins (Benutzername: admin).
# Wird beim Erstlogin zwingend geaendert.
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# Verschluesselt die gespeicherten Nutzdaten. Ohne diesen Schluessel sind die
# Daten nicht mehr lesbar -- er gehoert ins Backup, aber NICHT neben die
# Datenbanksicherung. Faellt auf SECRET_KEY zurueck, wenn nicht gesetzt.
#   openssl rand -hex 32
DATA_MASTER_KEY=change-me-openssl-rand-hex-32

# ── Datenbank ─────────────────────────────────────────────────────────────────
POSTGRES_USER=fckcats
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=fckcats

# ── Ports auf dem Host ────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Nur ausfuellen, wenn der Host nicht direkt ins Netz kommt. Leer bedeutet:
# kein Proxy. Gilt beim Bauen (apt, pip, npm) und zur Laufzeit (etwa ACME).
#   HTTP_PROXY=http://proxy.example.org:3128
HTTP_PROXY=
HTTPS_PROXY=

# Was am Proxy vorbeigeht. Die Dienstnamen des Stacks MUESSEN hier stehen
# bleiben -- sonst laeuft die Datenbankverbindung ueber den Proxy und
# scheitert. Eigene interne Domains einfach anhaengen.
NO_PROXY=localhost,127.0.0.1,postgres,api,nginx

# ── Optional ──────────────────────────────────────────────────────────────────
# Typische Wochenarbeitszeit; nur fuer die Plausibilitaetswarnung in der
# CATS-Config ("welche Gewichtung faellt unter die Mindestbuchung von 1 h").
TYPICAL_WEEK_HOURS=38
